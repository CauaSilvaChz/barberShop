APP_NAME="Barbearia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados MariaDB (no XAMPP o usuário padrão é "root" sem senha)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barbearia_app
DB_USERNAME=root
DB_PASSWORD=

# Endereço do frontend (liberado no CORS)
FRONTEND_URL=http://localhost:3000

# API sem sessão, sem filas e sem Redis
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# SMS
# SMS_DEV_MODE=true -> APENAS DESENVOLVIMENTO: não envia SMS, grava o código
# em storage/logs/laravel.log e devolve "dev_code" na resposta da API.
# É ignorado quando APP_ENV=production.
SMS_DEV_MODE=true

# Credenciais do Twilio (usadas quando SMS_DEV_MODE=false)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
